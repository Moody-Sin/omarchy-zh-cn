#!/usr/bin/python3
"""Collect Grok Build subscription limits without exposing its login token."""

from __future__ import annotations

import argparse
import base64
import json
import os
import tempfile
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path
from typing import Any


BILLING_URL = "https://cli-chat-proxy.grok.com/v1/billing?format=credits"
SETTINGS_URL = "https://cli-chat-proxy.grok.com/v1/settings"
CACHE_SECONDS = 60


def empty_stats() -> dict[str, Any]:
  return {
    "todayPrompts": 0, "todaySessions": 0, "todayTotalTokens": 0,
    "todayTokensByModel": {}, "recentDays": [], "totalPrompts": 0,
    "totalSessions": 0, "activeDays": 0, "activeDates": [], "modelUsage": {},
  }


def record(**values: Any) -> dict[str, Any]:
  result: dict[str, Any] = {
    "schemaVersion": 1, "id": "grok", "name": "Grok Build",
    "updatedAt": datetime.now(timezone.utc).isoformat(), "ready": False,
    "hasLocalStats": False, "hasPromptStats": False, "scope": "account",
    "tierLabel": "", "usageStatusText": "", "authHelpText": "", "limits": [],
  }
  result.update(empty_stats())
  result.update(values)
  return result


def grok_home() -> Path:
  return Path(os.path.expanduser(os.environ.get("GROK_HOME", "~/.grok")))


def cache_path() -> Path:
  root = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "omarchy" / "agent-usage"
  root.mkdir(parents=True, exist_ok=True)
  return root / "grok-limits.json"


def read_json(path: Path) -> dict[str, Any] | None:
  try:
    value = json.loads(path.read_text(encoding="utf-8"))
    return value if isinstance(value, dict) else None
  except Exception:
    return None


def write_json(path: Path, value: dict[str, Any]) -> None:
  fd, name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
  tmp = Path(name)
  try:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
      json.dump(value, handle, separators=(",", ":"), sort_keys=True)
      handle.write("\n")
    tmp.chmod(0o600)
    tmp.replace(path)
  except BaseException:
    tmp.unlink(missing_ok=True)
    raise


def parse_time(value: Any) -> datetime | None:
  try:
    parsed = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    return parsed.replace(tzinfo=timezone.utc) if parsed.tzinfo is None else parsed
  except Exception:
    return None


def login() -> dict[str, Any] | None:
  values = read_json(grok_home() / "auth.json") or {}
  candidates = []
  for value in values.values():
    if not isinstance(value, dict):
      continue
    token = str(value.get("key") or "").strip()
    if not token or token.startswith(("sk-", "xai-")):
      continue
    expiry = parse_time(value.get("expires_at"))
    candidates.append((expiry.timestamp() if expiry else 0, value))
  return max(candidates, key=lambda item: item[0])[1] if candidates else None


def cents(value: Any) -> float | None:
  if not isinstance(value, dict):
    return None
  try:
    return max(0.0, float(value.get("val") or 0) / 100.0)
  except (TypeError, ValueError):
    return None


def parse_limits(config: dict[str, Any]) -> list[dict[str, Any]]:
  period = config.get("currentPeriod") if isinstance(config.get("currentPeriod"), dict) else {}
  period_type = str(period.get("type") or "").upper()
  if "WEEK" in period_type:
    title = "每周"
  elif "MONTH" in period_type:
    title = "每月"
  elif "DAY" in period_type:
    title = "每日"
  else:
    title = "用量"

  percent = None
  raw = config.get("creditUsagePercent")
  if raw is not None:
    try:
      percent = min(1.0, max(0.0, float(raw) / 100.0))
    except (TypeError, ValueError):
      pass
  elif period:
    percent = 0.0
  if percent is None:
    used, cap = cents(config.get("used")), cents(config.get("monthlyLimit"))
    if used is not None and cap and cap > 0:
      percent, title = min(1.0, used / cap), "每月"

  limits = []
  if percent is not None:
    limits.append({
      "label": title, "title": title, "percent": percent,
      "startsAt": str(period.get("start") or config.get("billingPeriodStart") or ""),
      "resetsAt": str(period.get("end") or config.get("billingPeriodEnd") or ""),
    })
  return limits


def tier_from_token(token: str) -> str:
  try:
    part = token.split(".")[1]
    part += "=" * ((4 - len(part) % 4) % 4)
    tier = json.loads(base64.urlsafe_b64decode(part))["tier"]
  except Exception:
    return ""
  return {3: "SuperGrok", 4: "SuperGrok Plus", 5: "SuperGrok Heavy"}.get(tier, "")


def headers(token: str, user_id: str) -> dict[str, str]:
  return {
    "Authorization": "Bearer " + token, "Accept": "application/json",
    "X-XAI-Token-Auth": "xai-grok-cli", "x-userid": user_id,
    "x-grok-client-version": os.environ.get("GROK_CLIENT_VERSION", "1.0.5"),
  }


def get_json(url: str, request_headers: dict[str, str]) -> dict[str, Any]:
  request = urllib.request.Request(url, headers=request_headers)
  with urllib.request.urlopen(request, timeout=15) as response:
    if int(response.status) != 200:
      raise RuntimeError("unexpected status")
    value = json.loads(response.read(2 * 1024 * 1024).decode("utf-8", errors="replace"))
  if not isinstance(value, dict):
    raise ValueError("response is not an object")
  return value


def cached_record() -> dict[str, Any] | None:
  cached = read_json(cache_path())
  if not cached or not isinstance(cached.get("limits"), list):
    return None
  limits = [item for item in cached["limits"] if isinstance(item, dict)]
  if not limits and not isinstance(cached.get("balance"), dict):
    return None
  return cached


def collect(force: bool) -> dict[str, Any]:
  saved = cached_record()
  current = login()
  if current is None:
    return record(
      ready=bool(saved), limits=saved.get("limits", []) if saved else [],
      balance=saved.get("balance") if saved else None,
      tierLabel=str(saved.get("tierLabel") or "") if saved else "",
      usageStatusText="等待登录", authHelpText="运行 `grok login` 后会自动显示 Grok 限额。",
    )

  if saved and not force and time.time() - float(saved.get("fetchedAt", 0)) < CACHE_SECONDS:
    return record(ready=True, limits=saved["limits"], balance=saved.get("balance"),
                  tierLabel=str(saved.get("tierLabel") or ""))

  token = str(current.get("key") or "")
  request_headers = headers(token, str(current.get("user_id") or ""))
  try:
    payload = get_json(BILLING_URL, request_headers)
    config = payload.get("config")
    if not isinstance(config, dict):
      raise ValueError("missing credits config")
    limits = parse_limits(config)
    remaining = cents(config.get("prepaidBalance"))
    balance = ({"remaining": remaining, "funded": 0, "spent": 0,
                "currency": "USD", "estimated": False}
               if remaining is not None and remaining >= 0 else None)
    if not limits and balance is None:
      raise ValueError("missing usage limits")
    tier = ""
    try:
      settings = get_json(SETTINGS_URL, request_headers)
      tier = str(settings.get("subscription_tier_display") or settings.get("subscriptionTierDisplay") or "")
    except Exception:
      pass
    tier = tier or str(payload.get("subscriptionTier") or payload.get("subscription_tier") or "") or tier_from_token(token)
    snapshot = {"fetchedAt": time.time(), "limits": limits, "balance": balance, "tierLabel": tier}
    write_json(cache_path(), snapshot)
    return record(ready=True, limits=limits, balance=balance, tierLabel=tier)
  except urllib.error.HTTPError as error:
    auth_error = error.code in (401, 403)
  except Exception:
    auth_error = False

  if saved:
    return record(ready=True, limits=saved["limits"], balance=saved.get("balance"),
                  tierLabel=str(saved.get("tierLabel") or ""),
                  usageStatusText="Grok 限额暂不可用", authHelpText="正在显示上次成功获取的数据。")
  return record(usageStatusText="Grok 限额暂不可用",
                authHelpText=("登录已失效，请运行 `grok login`。" if auth_error
                              else "无法连接 Grok 用量接口，稍后会自动重试。"),
                retryAdvised=not auth_error)


def main() -> None:
  parser = argparse.ArgumentParser()
  parser.add_argument("--force", action="store_true")
  parser.add_argument("--limits-only", action="store_true")
  args = parser.parse_args()
  result = collect(args.force)
  if result.get("balance") is None:
    result.pop("balance", None)
  print(json.dumps(result, separators=(",", ":"), ensure_ascii=False))


if __name__ == "__main__":
  main()
